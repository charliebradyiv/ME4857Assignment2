<?xml version="1.0"?>
<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">

    <!-- Root sequence — runs all tasks in order -->
    <Sequence name="MissionRoot">

      <!-- Task 4 — Fire Safety Decorator — always active -->
      <Decorator ID="RepeatUntilFailure" name="FireSafetyDecorator">
        <Sequence name="FireSafetyCheck">
          <Action ID="CheckFireDistance" distance_threshold="3.0"/>
        </Sequence>
      </Decorator>

      <!-- Task 3 — Battery Check Fallback -->
      <Fallback name="BatteryFallback">
        <Condition ID="BatteryOK" name="CheckBattery"/>
        <Sequence name="DockingSequence">
          <Action ID="NavigateToDock" name="GoToDock"/>
          <Action ID="WaitForCharge" name="ChargeBattery"/>
        </Sequence>
      </Fallback>

      <!-- Task 1 — Bring Medical Kit to Survivor -->
      <Sequence name="Task1_MedicalKit">
        <Action ID="NavigateTo" name="GoToSurvivor" target="survivor"/>
        <Action ID="StopAtDistance" name="StopNearSurvivor" distance="1.0"/>
        <Action ID="Wait" name="WaitOneSec" seconds="1"/>
        <Action ID="PublishSurvivorTF" name="BroadcastSurvivorTF"/>
        <Action ID="NavigateTo" name="GoToMedKit" target="medical_kit"/>
        <Action ID="NavigateTo" name="ReturnToSurvivor" target="survivor"/>
      </Sequence>

      <!-- Task 2 — Scan the Dam -->
      <Sequence name="Task2_ScanDam">
        <Action ID="NavigateTo" name="GoToDam" target="dam"/>
        <Action ID="StopAtDistance" name="StopNearDam" distance="0.5"/>
        <Action ID="RotateCamera" name="RotateLeft" angle="-10"/>
        <Action ID="RotateCamera" name="RotateRight" angle="10"/>
      </Sequence>

      <!-- Task 5 — Exit the Building -->
      <Sequence name="Task5_Exit">
        <Action ID="NavigateTo" name="GoToExit" target="exit"/>
        <Action ID="StopAndWait" name="WaitAtExit"/>
      </Sequence>

    </Sequence>
  </BehaviorTree>
</root>