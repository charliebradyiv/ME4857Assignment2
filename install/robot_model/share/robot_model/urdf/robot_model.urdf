<?xml version="1.0"?>
<robot name="robot_model">

  <!-- ================= MATERIALS ================= -->
  <material name="black"><color rgba="0 0 0 1"/></material>
  <material name="grey"><color rgba="0.75 0.75 0.75 1"/></material>

  <!-- ================= BASE FRAME (GROUND REFERENCE) ================= -->
  <link name="base_footprint"/>

  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.075" rpy="0 0 0"/>
  </joint>

  <!-- ================= BASE ================= -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 0 0"/>
      <mass value="20"/>
      <inertia ixx="0.2" ixy="0" ixz="0" iyy="0.5" iyz="0" izz="0.5"/>
    </inertial>
    <visual>
      <geometry><mesh filename="package://robot_model/meshes/base_link.STL"/></geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0.01 0 0"/>
      <geometry><box size="0.33 0.25 0.12"/></geometry>
    </collision>
  </link>

  <!-- ==================== RIGHT SIDE WHEELS ==================== -->
  <link name="link_BR">
    <inertial>
      <origin xyz="0 0.03 0" rpy="0 0 0"/>
      <mass value="1.0412"/>
      <inertia ixx="0.0018022" ixy="0" ixz="0" iyy="0.00298" iyz="0" izz="0.0018022"/>
    </inertial>
    <visual><geometry><mesh filename="package://robot_model/meshes/link_BR.STL"/></geometry><material name="black"/></visual>
    <collision><origin xyz="0 0.03 0" rpy="1.5707963 0 0"/><geometry><cylinder radius="0.075" length="0.06"/></geometry></collision>
  </link>
  <joint name="joint_BR" type="continuous">
    <origin xyz="-0.15855 -0.185 -0.075" rpy="0 0 0"/>
    <parent link="base_link"/><child link="link_BR"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <link name="link_MR">
    <inertial>
      <origin xyz="0 0.03 0" rpy="0 0 0"/>
      <mass value="1.0412"/>
      <inertia ixx="0.0018022" ixy="0" ixz="0" iyy="0.00298" iyz="0" izz="0.0018022"/>
    </inertial>
    <visual><geometry><mesh filename="package://robot_model/meshes/link_MR.STL"/></geometry><material name="black"/></visual>
    <collision><origin xyz="0 0.03 0" rpy="1.5707963 0 0"/><geometry><cylinder radius="0.075" length="0.06"/></geometry></collision>
  </link>
  <joint name="joint_MR" type="continuous">
    <origin xyz="0.0081106 -0.185 -0.075" rpy="0 0 0"/>
    <parent link="base_link"/><child link="link_MR"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <link name="link_FR">
    <inertial>
      <origin xyz="0 0.03 0" rpy="0 0 0"/>
      <mass value="1.0412"/>
      <inertia ixx="0.0018022" ixy="0" ixz="0" iyy="0.00298" iyz="0" izz="0.0018022"/>
    </inertial>
    <visual><geometry><mesh filename="package://robot_model/meshes/link_FR.STL"/></geometry><material name="black"/></visual>
    <collision><origin xyz="0 0.03 0" rpy="1.5707963 0 0"/><geometry><cylinder radius="0.075" length="0.06"/></geometry></collision>
  </link>
  <joint name="joint_FR" type="continuous">
    <origin xyz="0.17478 -0.185 -0.075" rpy="0 0 0"/>
    <parent link="base_link"/><child link="link_FR"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- ==================== LEFT SIDE WHEELS ==================== -->
  <link name="link_BL">
    <inertial>
      <origin xyz="0 -0.03 0" rpy="0 0 0"/>
      <mass value="1.0412"/>
      <inertia ixx="0.0018022" ixy="0" ixz="0" iyy="0.00298" iyz="0" izz="0.0018022"/>
    </inertial>
    <visual><geometry><mesh filename="package://robot_model/meshes/link_BL.STL"/></geometry><material name="black"/></visual>
    <collision><origin xyz="0 -0.03 0" rpy="1.5707963 0 0"/><geometry><cylinder radius="0.075" length="0.06"/></geometry></collision>
  </link>
  <joint name="joint_BL" type="continuous">
    <origin xyz="-0.15855 0.185 -0.075" rpy="0 0 0"/>
    <parent link="base_link"/><child link="link_BL"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <link name="link_ML">
    <inertial>
      <origin xyz="0 -0.03 0" rpy="0 0 0"/>
      <mass value="1.0412"/>
      <inertia ixx="0.0018022" ixy="0" ixz="0" iyy="0.00298" iyz="0" izz="0.0018022"/>
    </inertial>
    <visual><geometry><mesh filename="package://robot_model/meshes/link_ML.STL"/></geometry><material name="black"/></visual>
    <collision><origin xyz="0 -0.03 0" rpy="1.5707963 0 0"/><geometry><cylinder radius="0.075" length="0.06"/></geometry></collision>
  </link>
  <joint name="joint_ML" type="continuous">
    <origin xyz="0.0081106 0.185 -0.075" rpy="0 0 0"/>
    <parent link="base_link"/><child link="link_ML"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <link name="link_FL">
    <inertial>
      <origin xyz="0 -0.03 0" rpy="0 0 0"/>
      <mass value="1.0412"/>
      <inertia ixx="0.0018022" ixy="0" ixz="0" iyy="0.00298" iyz="0" izz="0.0018022"/>
    </inertial>
    <visual><geometry><mesh filename="package://robot_model/meshes/link_FL.STL"/></geometry><material name="black"/></visual>
    <collision><origin xyz="0 -0.03 0" rpy="1.5707963 0 0"/><geometry><cylinder radius="0.075" length="0.06"/></geometry></collision>
  </link>
  <joint name="joint_FL" type="continuous">
    <origin xyz="0.17478 0.185 -0.075" rpy="0 0 0"/>
    <parent link="base_link"/><child link="link_FL"/>
    <axis xyz="0 1 0"/>
    <dynamics damping="0.1" friction="0.1"/>
  </joint>

  <!-- ================= SENSOR LINKS ================= -->
  <link name="imu_link">
    <inertial>
      <mass value="0.01"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/>
    </inertial>
  </link>
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/><child link="imu_link"/>
    <origin xyz="0 0 0.1"/>
  </joint>

  <link name="lidar_link">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
    <visual>
      <geometry><cylinder radius="0.03" length="0.04"/></geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/><child link="lidar_link"/>
    <origin xyz="0.2 0 0.15"/>
  </joint>

  <link name="camera_link">
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="1e-5" ixy="0" ixz="0" iyy="1e-5" iyz="0" izz="1e-5"/>
    </inertial>
    <visual>
      <geometry><box size="0.04 0.06 0.04"/></geometry>
      <material name="black"/>
    </visual>
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link"/><child link="camera_link"/>
    <origin xyz="0.25 0 0.2"/>
  </joint>

  <!-- ================= ROS 2 CONTROL ================= -->
  <ros2_control name="GazeboSimSystem" type="system">
    <hardware>
      <plugin>gz_ros2_control/GazeboSimSystem</plugin>
    </hardware>
    <joint name="joint_FL"><command_interface name="velocity"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="joint_ML"><command_interface name="velocity"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="joint_BL"><command_interface name="velocity"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="joint_FR"><command_interface name="velocity"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="joint_MR"><command_interface name="velocity"/><state_interface name="position"/><state_interface name="velocity"/></joint>
    <joint name="joint_BR"><command_interface name="velocity"/><state_interface name="position"/><state_interface name="velocity"/></joint>
  </ros2_control>

  <!-- ================= GAZEBO PLUGINS ================= -->
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(find robot_model)/config/controllers.yaml</parameters>
    </plugin>
  </gazebo>

  <!-- ================= SENSOR PLUGINS ================= -->
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu/>
    </sensor>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <always_on>true</always_on>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <topic>scan</topic>
      <gz_frame_id>lidar_link</gz_frame_id>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.1</min>
          <max>10.0</max>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <gazebo reference="camera_link">
    <sensor name="camera" type="camera">
      <always_on>true</always_on>
      <update_rate>30</update_rate>
      <topic>camera/image_raw</topic>
      <gz_frame_id>camera_link</gz_frame_id>
      <camera>
        <horizontal_fov>1.57</horizontal_fov>
        <image><width>640</width><height>480</height></image>
        <clip><near>0.1</near><far>100.0</far></clip>
      </camera>
    </sensor>
  </gazebo>

</robot>